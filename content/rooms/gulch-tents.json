      "id": "washing_line",
      "name": "THE WASHING LINE",
      "rect": [
        950,
        200,
        180,
        110
      ],
      "defaultVerb": "LOOK_AT",
      "responses": {
        "LOOK_AT": [
          {
            "say": "Shirts on a line between two tents. Every one has a padlock on the pocket.",
            "repeat": [
              "Good shirts, too. Store-bought. Washed by somebody else, I'd bet.",
              "One shirt has a padlock and no buttons. A man has his priorities."
            ]
          }
        ],
        "LISTEN_TO": [
          {
            "say": "Shirts flapping.",
            "repeat": [
              "A padlock knocking against a peg.",
              "Washing, drying, with nothing to add."
            ]
          }
        ]
      },
      "overrides": {
        "OPEN": "Every pocket's padlocked. I tried one, to see. A man across the way stood up."
      },
      "walkTo": {
        "x": 1040,
        "y": 452,
        "facing": "back"
      }
    },
    {
      "id": "notice",
      "name": "THE NOTICE",
      "rect": [
        1250,
        410,
        210,
        230
      ],
      "defaultVerb": "LOOK_AT",
      "responses": {
        "LOOK_AT": [
          {
            "say": "A notice nailed to a stump: CLAIM JUMPERS WILL BE SPOKEN TO. Underlined twice.",
            "repeat": [
              "Underneath, in another hand: FIRMLY.",
              "It's the most threatening thing I've read since Mr. Sump's forms."
            ]
          }
        ],
        "LISTEN_TO": [
          {
            "say": "A nail working loose.",
            "repeat": [
              "The notice flapping at one corner.",
              "Quiet. It's said its piece, firmly."
            ]
          }
        ]
      },
      "overrides": {
        "PULL": "Taking down a notice against strangers would make me the stranger it means.",
        "TALK_TO": "I told it I wasn't a jumper. It went on saying FIRMLY."
      },
      "walkTo": {
        "x": 1350,
        "y": 660,
        "facing": "back"
      }
    },
    {
      "id": "cook_fire",
      "name": "THE COOK FIRE",
      "rect": [
        730,
        360,
        280,
        250
      ],
      "defaultVerb": "LOOK_AT",
      "responses": {
        "LOOK_AT": [
          {
            "say": "A cook fire with a kettle on it and somebody's dinner in a pan. Nobody's watching it.",
            "repeat": [
              "Beans, with something better than beans in them. They eat well here. They can afford to.",
              "I'm not going to steal a man's dinner. I've thought it through, and I'm not."
            ],
            "then": [
              "Everybody's watching me."
            ]
          }
        ],
        "LISTEN_TO": [
          {
            "say": "Beans, ticking in the pan.",
            "repeat": [
              "The kettle working up to something.",
              "Fat spitting. The best sound in two days."
            ]
          }
        ]
      },
      "overrides": {
        "USE": "I warmed my hands at it. Nobody stopped me. It's the friendliest thing in camp."
      },
      "walkTo": {
        "x": 880,
        "y": 640,
        "facing": "back"
      }
    },
    {
      "id": "tents",
      "name": "THE TENTS",
      "rect": [
        1140,
        80,
        420,
        390
      ],
      "defaultVerb": "LOOK_AT",
      "responses": {
        "LOOK_AT": [
          {
            "say": "Canvas tents, every one pegged down twice and guyed like a ship.",
            "repeat": [
              "One tent has a sign on it: KNOCK. You can't knock on a tent. That's the idea.",
              "In Consolation the tents are full of hope. These are full of gold, and it's made them twitchy."
            ]
          }
        ],
        "LISTEN_TO": [
          {
            "say": "Canvas breathing in the wind.",
            "repeat": [
              "Behind one flap, coins being stacked, carefully.",
              "Somebody snoring lightly, like a man ready to wake."
            ]
          }
        ]
      },
      "overrides": {
        "OPEN": "I lifted a flap. Somebody inside said 'No', very calmly, and I put it down."
      },
      "walkTo": {
        "x": 1200,
        "y": 560,
        "facing": "back"
      }
    },
    {
      "id": "cabins",
      "name": "THE CABINS",
      "rect": [
        0,
        60,
        490,
        350
      ],
      "defaultVerb": "LOOK_AT",
      "responses": {
        "LOOK_AT": [
          {
            "say": "Log cabins with chimneys of sticks and mud.",
            "repeat": [
              "One cabin has three locks and no window. Whoever's inside has done well.",
              "I knocked on one, to be friendly. A bolt went across inside. Then a second."
            ],
            "then": [
              "The doors have more bolts than the walls have logs."
            ]
          }
        ],
        "LISTEN_TO": [
          {
            "say": "A bolt sliding home.",
            "repeat": [
              "Inside one, a man counting under his breath.",
              "Counting again. He's lost his place and started over."
            ]
          }
        ]
      },
      "overrides": {
        "OPEN": "I tried a latch. Three bolts answered from inside, one after another, like a choir."
      },
      "walkTo": {
        "x": 440,
        "y": 462,
        "facing": "back"
      }
    }
