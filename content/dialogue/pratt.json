      "options": [
        {
          "id": "pratt1",
          "tag": "PROGRESS",
          "afterUse": "remove",
          "text": "There's a raccoon in my hole. Would you get him out?",
          "exchange": [
            {
              "speaker": "pratt",
              "line": "Raccoon."
            },
            {
              "speaker": "pratt",
              "line": "He thinks about it for some time.",
              "direction": true
            },
            {
              "speaker": "pratt",
              "line": "All right."
            },
            {
              "speaker": "pratt",
              "line": "He walks over, unhurried, and reaches into the hole. The bite. He withdraws the hand and studies it.",
              "direction": true
            },
            {
              "speaker": "pratt",
              "line": "He's in there."
            },
            {
              "speaker": "pratt",
              "line": "From this moment Pratt dislikes Thad, steadily and without heat, the way he does everything.",
              "direction": true
            }
          ],
          "when": {
            "T_WARM_HOLE": false
          },
          "set": {
            "T_PRATT_BITTEN": true
          }
        },
        {
          "id": "pratt2",
          "tag": "TOPIC",
          "afterUse": "retain",
          "text": "Nine dollars for what?",
          "repeat": "Your claim. Nine dollars and a hen.",
          "exchange": [
            {
              "speaker": "pratt",
              "line": "Your claim."
            },
            {
              "speaker": "pratt",
              "line": "He says it as though it were the weather.",
              "direction": true
            }
          ]
        },
        {
          "id": "pratt5",
          "tag": "TOPIC",
          "afterUse": "retain",
          "text": "Did you know Ezra Pike?",
          "exchange": [
            {
              "speaker": "pratt",
              "line": "Yep."
            },
            {
              "speaker": "pratt",
              "line": "He rakes for a while.",
              "direction": true
            },
            {
              "speaker": "pratt",
              "line": "Undertaker's got him."
            }
          ],
          "repeat": "Undertaker's got him. Has had for a while.",
          "when": {
            "T_PIKE_DEAD": false
          }
        },
        {
          "id": "pratt6",
          "tag": "TOPIC",
          "afterUse": "retain",
          "text": "You knew Pike was dead.",
          "exchange": [
            {
              "speaker": "pratt",
              "line": "Yep."
            },
            {
              "speaker": "pratt",
              "line": "He rakes.",
              "direction": true
            },
            {
              "speaker": "pratt",
              "line": "Said so."
            }
          ],
          "repeat": "Said the undertaker had him. That's what that means.",
          "when": {
            "T_PIKE_DEAD": true
          }
        },
        {
          "id": "pratt3",
          "tag": "COMIC",
          "afterUse": "retain",
          "text": "Lovely morning.",
          "repeat": "Still is.",
          "exchange": [
            {
              "speaker": "pratt",
              "line": "He looks up at the sky, checking.",
              "direction": true
            },
            {
              "speaker": "pratt",
              "line": "Yep."
            }
          ]
        },
        {
          "id": "pratt4",
          "tag": "COMIC",
          "afterUse": "retain",
          "text": "How's the bite?",
          "say": "Healing wrong.",
          "when": {
            "T_PRATT_BITTEN": true
          }
        },
        {
          "id": "prattx",
          "tag": "EXIT",
          "text": "I should go.",
          "universal": true,
          "ends": true
        }
