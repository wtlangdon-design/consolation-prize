{
  "name": "consolation-prize",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node tools/run-all.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run typecheck && npm run validate && npm run test",
    "renders": "node tools/render-all.mjs",
    "gauntlet": "node tools/gauntlet/run.mjs",
    "gauntlet:full": "node --experimental-strip-types --no-warnings tools/gauntlet/full-game.mjs",
    "proof": "node tools/gauntlet/proof.mjs",
    "art:gates": "node tools/art/gates.mjs",
    "art:staging": "node tools/art/staging.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
